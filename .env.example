# Both AI tools (deck evaluator + website reviewer) call Claude directly through
# the open-source Vercel AI SDK's Anthropic provider (lib/ai.ts,
# @ai-sdk/anthropic, model "claude-opus-5") — not through Vercel AI Gateway.
# This bills against your own Anthropic account, with no Vercel-side
# credit-card requirement (AI Gateway requires one on file even to use its
# free monthly credits, which is why this app doesn't route through it).
#
# The `anthropic` provider resolves credentials itself, in order:
# ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN. For local dev, set
# ANTHROPIC_API_KEY below. In Vercel's dashboard, add it directly as an
# environment variable (Project -> Settings -> Environment Variables) for the
# Production environment — never paste it anywhere else (a chat, a commit,
# this file with a real value in it).
ANTHROPIC_API_KEY=

# Required outside Vercel (local dev, this sandbox, or any other host):
# point this at a real Chromium binary. Install one locally with
# `npx playwright install chromium`, then set this to the path it reports.
# On Vercel, leave this unset — lib/screenshot.ts detects the VERCEL env var
# (set automatically by the platform) and uses @sparticuz/chromium instead.
PLAYWRIGHT_EXECUTABLE_PATH=
