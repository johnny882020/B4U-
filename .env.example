# Anthropic credentials for both AI tools (deck evaluator + website reviewer).
# The SDK resolves credentials itself, in order: ANTHROPIC_API_KEY ->
# ANTHROPIC_AUTH_TOKEN -> the active `ant auth login` CLI profile -> Workload
# Identity Federation env vars -> the default profile on disk. So for local
# dev you can leave this file's ANTHROPIC_API_KEY blank entirely and just run
# `ant auth login` once instead — no env var needed. See README for the
# production/Render tradeoff between these.
ANTHROPIC_API_KEY=

# Optional: override Playwright's Chromium executable path.
# Sandbox/CI environments with a pre-installed browser typically set this to
# something like /opt/pw-browsers/chromium. In production, point this at
# wherever your deploy target provides a Chromium binary (see README for the
# serverless-deployment caveat around Playwright + Chromium).
PLAYWRIGHT_EXECUTABLE_PATH=
